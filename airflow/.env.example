# Copy this file to airflow/.env and configure your local environment.
# Never commit airflow/.env or real secrets.

AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
AIRFLOW_IMAGE_NAME=e2e-de-airflow:3.3.1
ENV_FILE_PATH=../.env

# Generate a new Fernet key for your own environment.
FERNET_KEY=REPLACE_WITH_NEW_FERNET_KEY

# Replace with a unique, random JWT secret.
AIRFLOW__API_AUTH__JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET

_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
